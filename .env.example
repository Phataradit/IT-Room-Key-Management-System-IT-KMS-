# Neon PostgreSQL (Connection Pooling for application queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL (Direct connection for Prisma CLI migrations)
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Cron API Authorization
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Upload & OCR Limits
NEXT_PUBLIC_ROOM_SCHEDULE_IMPORT_MAX_BYTES="26214400"
NEXT_PUBLIC_ROOM_SCHEDULE_IMPORT_MAX_PAGES="100"
ROOM_SCHEDULE_IMPORT_CONFIDENCE_HIGH="80"
ROOM_SCHEDULE_IMPORT_CONFIDENCE_LOW="50"
